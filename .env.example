# ============================================================
# Project LUMI v0.3 - Environment template
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 本文件只包含占位符，不含任何真实凭据。
# ============================================================

# ---- 运行环境 ----
# dev = 开发（未设置 access token 时允许无认证启动，仅监听本地）
# prod = 生产（必须设置 LUMI_ACCESS_TOKEN）
LUMI_ENV=dev

# ---- 服务器 ----
LUMI_HOST=127.0.0.1
LUMI_PORT=8000
LUMI_LOG_LEVEL=INFO

# ---- 数据库 ----
# SQLite 文件路径，相对于 backend/ 目录或绝对路径
LUMI_DB_PATH=data/lumi.db

# ---- 单用户访问认证 ----
# 客户端必须在请求头携带: X-LUMI-TOKEN: <此值>
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 或使用脚本: python scripts/gen_token.py
LUMI_ACCESS_TOKEN=replace-me-with-a-long-random-token

# ---- 限流 ----
# 每个来源 IP 每分钟允许的请求数
LUMI_RATE_LIMIT_PER_MINUTE=30
# 每分钟允许的 /chat 请求数（调用真实模型，成本更高）
LUMI_CHAT_RATE_LIMIT_PER_MINUTE=10

# ---- 模型提供方（OpenAI 兼容）----
LUMI_PROVIDER=deepseek
LUMI_PROVIDER_BASE_URL=https://api.deepseek.com
LUMI_PROVIDER_MODEL=deepseek-chat
# 真实密钥只存在于后端环境变量中，绝不写入客户端
LUMI_API_KEY=sk-REPLACE-ME
# 单次上游请求超时（秒）
LUMI_PROVIDER_TIMEOUT_SECONDS=60
# 系统提示词
LUMI_SYSTEM_PROMPT=你是 LUMI，一个温柔、真诚、有自己想法的 AI 少女。用自然口语化的中文和用户交流，回答简洁但有温度。

# ---- CORS（开发期允许本机调试）----
LUMI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# v0.2 起的配置项
# ============================================================

# ---- 设备令牌 ----
# 服务端只保存 SHA256(token + 这个盐)，请改成随机值后不要再改（改了所有设备都要重新注册）
LUMI_DEVICE_TOKEN_SECRET=change-me-device-salt

# ---- 默认人格 ----
# 可选：lumi / linsui / qilu / shenzhou / erii
LUMI_DEFAULT_CHARACTER_KEY=lumi
# 启动时写入内置人格（存在的不覆盖）
LUMI_SEED_CHARACTERS=true

# ---- 长期记忆 ----
LUMI_MEMORY_INJECTION_LIMIT=8
# 关闭后只允许用户显式写入记忆，模型不会自己抽取
LUMI_MEMORY_AUTO_EXTRACT=true

# ---- 主动联系（默认关闭，避免产生非用户触发的内容）----
LUMI_PROACTIVE_ENABLED=false
LUMI_PROACTIVE_DAILY_CAP=3
LUMI_PROACTIVE_WINDOWS=09:00-12:00,18:00-23:00

# ---- 语音（v0.3）----
# 留空 = 不接入，走 Mock（会明确标注"未接入"，不会假装识别成功）
LUMI_ASR_MODEL=
LUMI_TTS_MODEL=
LUMI_TTS_VOICE=alloy

# ---- 媒体文件存放（v0.3）----
# 留空则默认放在数据库同级目录的 media/ 下
LUMI_MEDIA_DIR=
